# 复制为 deploy/.env，数据库密码只使用 64 位随机十六进制字符，避免 URI 转义问题。
API_DOMAIN=hrgos.skyseiun.com
FRONTEND_ORIGINS=http://127.0.0.1:3001,http://localhost:3001,https://hrgos.skyseiun.com
POSTGRES_PASSWORD=replace_with_64_random_hex_characters
TEST_API_KEY=replace_with_another_64_random_hex_characters
GAME_ADMIN_KEY=replace_with_a_third_64_random_hex_value
# 联调期间可改为 true，验收结束后关闭。正式比赛接口使用另一份管理密钥。
TEST_API_ENABLED=false
